# ── Публичные данные сайта ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=                # https://proba-lab.ru (без слэша в конце)
NEXT_PUBLIC_CONTACT_EMAIL=           # почта для заявок, показывается на сайте
NEXT_PUBLIC_TELEGRAM_URL=            # https://t.me/...
NEXT_PUBLIC_PHONE=                   # необязательно
NEXT_PUBLIC_LEGAL_ENTITY_NAME=       # ИП Фамилия И. О. / ООО «...»
NEXT_PUBLIC_INN=
NEXT_PUBLIC_OGRN=
NEXT_PUBLIC_OGRN_LABEL=ОГРНИП        # ОГРН для ООО
NEXT_PUBLIC_PRICING_NOTE=            # напр.: Цены указаны без НДС, исполнитель применяет УСН.
NEXT_PUBLIC_LEGAL_REVIEWED=false     # true — после проверки /privacy и /consent юристом
NEXT_PUBLIC_SHOW_PROJECTS=false      # true — показать блок проектов (только с согласием клиентов)
NEXT_PUBLIC_ROBOTS_NOINDEX=false     # true — закрыть сайт от индексации (превью)

# ── Аналитика и антиспам ───────────────────────────────────────────
NEXT_PUBLIC_YM_ID=                   # номер счётчика Яндекс Метрики (грузится только после согласия на cookie)
NEXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY= # Yandex SmartCaptcha (необязательно)
SMARTCAPTCHA_SERVER_KEY=
RATE_LIMIT_MAX=5                     # заявок с одного IP
RATE_LIMIT_WINDOW_SEC=600            # за окно, секунд

# ── Каналы доставки заявок (включаются заполнением) ────────────────
# Email через SMTP (Яндекс 360: smtp.yandex.ru, 465, SSL; пароль приложения)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_FROM=                     # "Proba Lab <noreply@домен>"
LEAD_EMAIL_TO=                       # через запятую
# Telegram-бот
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Универсальный webhook (любая CRM / n8n / Albato); подпись HMAC в X-Signature
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Bitrix24: входящий вебхук с правами CRM, вида https://portal.bitrix24.ru/rest/1/xxxx/
BITRIX24_WEBHOOK_URL=

# ── Сборка ─────────────────────────────────────────────────────────
STRICT_PLACEHOLDERS=false            # true в production: сборка падает при незаполненных данных
